            scalar y = Cf[faceI].y() - y0;                // y in [0,H]
            scalar Ux = 6.0*Ubar*(y*(H - y))/(H*H);       // mean(Ux)=Ubar
            U[faceI] = vector(Ux, 0, 0);
        }
    #};
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}


