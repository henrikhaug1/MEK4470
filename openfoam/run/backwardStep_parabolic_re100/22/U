            scalar Ux = 6.0*Ubar*(y*(H - y))/(H*H);       // mean(Ux)=Ubar
            U[faceI] = vector(Ux, 0, 0);
        }
    #};
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}


