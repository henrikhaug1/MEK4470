		const vectorField& Cf = patch().Cf();
		vectorField& field = *this;
		forAll(Cf, faceI)
		{
			const scalar x = Cf[faceI][0];
			field[faceI] = vector((1-x)*(1-x)*(1+x)*(1+x),0,0);
		}
	#};
    }
    fixedWalls
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}


