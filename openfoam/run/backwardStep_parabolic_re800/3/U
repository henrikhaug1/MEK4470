        const vectorField& Cf = patch().Cf();
        vectorField& U = *this;

        const scalar y0   = 0.1;   // bottom of inlet (meters)
        const scalar H    = 0.1;   // inlet height (meters) = 1.0*convertToMeters
        const scalar Ubar = 1.0;   // desired MEAN inlet velocity

        forAll(Cf, faceI)
